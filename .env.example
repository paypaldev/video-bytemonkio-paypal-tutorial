# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own SANDBOX values.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials — not even sandbox ones.
# Every value below comes from https://developer.paypal.com/dashboard/
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# "sandbox" or "live". This repo is a demo; keep it on sandbox.
PAYPAL_ENV=sandbox

# --- REST app credentials --------------------------------------------------
# Dashboard -> Apps & Credentials -> Sandbox -> your app.
# The client ID is browser-safe (it ships to the frontend).
# The secret is server-only and must never appear in public/ or in git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Webhooks --------------------------------------------------------------
# Dashboard -> Apps & Credentials -> your app -> Webhooks -> Add webhook.
# You get this ID after subscribing your tunnel URL to events.
# It is REQUIRED for signature verification — verification cannot work without it.
PAYPAL_WEBHOOK_ID=

# The public HTTPS URL that forwards to this machine (ngrok, cloudflared, etc).
# Used only to print correct instructions; PayPal is configured in the dashboard.
PUBLIC_BASE_URL=

# --- Local server ----------------------------------------------------------
PORT=8888

# --- Checkout defaults -----------------------------------------------------
CURRENCY=USD
# Venmo is US-only. In sandbox, buyer-country forces eligibility for testing.
# Never send buyer-country in production.
BUYER_COUNTRY=US

# ---------------------------------------------------------------------------
# Optional. Everything above is required; everything below has a sane default
# and is here so the knobs are discoverable rather than buried in the code.
# ---------------------------------------------------------------------------

# Which webhook verification method the listener uses.
#
#   self      verify the signature locally against PayPal's certificate.
#             No extra API call, no dependency on PayPal being reachable at
#             the moment an event lands. This is PayPal's recommendation.
#   postback  send the transmission back to PayPal and let them verify it.
#             Simpler, one more network round trip, and one more thing that
#             can be down exactly when events are arriving in bulk.
#
# Both are implemented. Switch this and re-run a webhook scenario to compare
# them; the verification time is printed for each event.
WEBHOOK_VERIFY_METHOD=self

# Print full JSON request and response bodies. Off by default because the
# scenario output is formatted to be readable on screen, and raw JSON is not.
# VERBOSE=1

# Where this application keeps its own records: events seen, orders fulfilled,
# capture attempts, subscriptions. Git-ignored, safe to delete, and separate
# from anything PayPal stores. The test suite overrides it so a test run cannot
# disturb a demo you are part way through.
# DATA_DIR=.data

# Standard, honoured by the console output. Set it to disable colour.
# NO_COLOR=1
